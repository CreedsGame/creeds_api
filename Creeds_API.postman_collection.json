{
	"info": {
		"_postman_id": "creeds-api-collection",
		"name": "Creeds Game API",
		"description": "Collection of API endpoints for the Creeds Game API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Character Management",
			"item": [
				{
					"name": "Create Character",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "name",
									"value": "warrior",
									"type": "text"
								},
								{
									"key": "password",
									"value": "123456",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/characters",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"characters"
							]
						},
						"description": "Creates a new character with the given name and password"
					},
					"response": []
				},
				{
					"name": "Get Character by Name",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/characters/:name",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"characters",
								":name"
							],
							"variable": [
								{
									"key": "name",
									"value": "warrior"
								}
							]
						},
						"description": "Retrieves character information by name"
					},
					"response": []
				},
				{
					"name": "Get All Characters",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/characters",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"characters"
							]
						},
						"description": "Retrieves a list of all characters"
					},
					"response": []
				},
				{
					"name": "Login Character",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "name",
									"value": "warrior",
									"type": "text"
								},
								{
									"key": "password",
									"value": "123456",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/characters/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"characters",
								"login"
							]
						},
						"description": "Validates character credentials"
					},
					"response": []
				}
			],
			"description": "APIs for managing game characters"
		},
		{
			"name": "Battle Management",
			"item": [
				{
					"name": "Execute Battle",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "fighter",
									"value": "warrior",
									"type": "text"
								},
								{
									"key": "opponent",
									"value": "mage",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/battles",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"battles"
							]
						},
						"description": "Executes a battle between two characters and returns the result"
					},
					"response": []
				}
			],
			"description": "APIs for managing game battles"
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080/api/v1",
			"type": "string"
		}
	]
}

